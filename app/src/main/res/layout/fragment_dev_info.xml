<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <!-- Back arrow and title -->
    <LinearLayout
        android:layout_marginTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developer info"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

    <!-- Outer Box for all data (Image, Name, Student Info) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="22dp"
        android:background="@drawable/rounded_box1"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/profile_photo"
            android:scaleType="centerCrop"
            android:layout_marginBottom="16dp"/>

        <!-- Name -->
        <TextView
            android:id="@+id/fullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gayantha Gimhana"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- Full Name Label and Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/fullNameValue"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/rounded_box"
            android:padding="10dp"
            android:text="R.M.G.G.Jayasooriya"
            android:textColor="#000000"
            android:gravity="center_vertical" />

        <!-- Student Number Label and Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Number"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/studentNumberValue"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/rounded_box"
            android:padding="10dp"
            android:text="2022101539"
            android:textColor="#000000"
            android:gravity="center_vertical" />

        <!-- Email Label and Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/emailValue"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/rounded_box"
            android:padding="10dp"
            android:text="2022101539@stu.cmb.ac.lk"
            android:textColor="#000000"
            android:gravity="center_vertical" />

        <!-- Version Label and Box -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/versionValue"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/rounded_box"
            android:padding="10dp"
            android:text="1.0.0"
            android:textColor="#000000"
            android:gravity="center_vertical" />

    </LinearLayout>

    <ImageView
        android:id="@+id/logo"
        android:layout_width="150sp"
        android:layout_height="50dp"
        android:src="@drawable/logo"
        android:scaleType="centerCrop"
        android:layout_marginTop="12dp"/>


</LinearLayout>

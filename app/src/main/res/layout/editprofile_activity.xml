<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background"
    tools:context=".ProfileUpdateActivity">

    <TextView
        android:id="@+id/edit_profile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:layout_marginTop="12dp"
        android:layout_gravity="center"
        android:textSize="24sp"
        android:textColor="#000000"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/profile_image"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center"
        android:src="@drawable/profile_picture"
        android:layout_marginBottom="16dp"
        android:contentDescription="Profile Image"/>

    <Button
        android:id="@+id/edit_photo_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Photo"
        android:layout_gravity="center"
        android:backgroundTint="#FFFFFF"
        android:textColor="#000000"
        android:layout_marginBottom="24dp"
        android:visibility="gone"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:textColor="#000000"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"/>
    <TextView
        android:id="@+id/full_name_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/rounded_box"
        android:layout_marginBottom="16dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:hint="Tap to edit full name" /> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Email"
    android:textColor="#000000"
    android:textSize="16sp"
    android:layout_marginBottom="4dp"/>
    <TextView
        android:id="@+id/email_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/rounded_box"
        android:layout_marginBottom="16dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:text="example@domain.com"
        android:alpha="0.7" /> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Phone Number"
    android:textColor="#000000"
    android:textSize="16sp"
    android:layout_marginBottom="4dp"/>
    <TextView
        android:id="@+id/phone_number_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@drawable/rounded_box"
        android:layout_marginBottom="24dp"
        android:textColor="#000000"
        android:textSize="16sp"
        android:hint="Tap to edit phone number" /> <LinearLayout
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:padding="8dp">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/updatebtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rounded_button_bg"
        android:layout_marginEnd="8dp"
        android:text="Edit Profile"
        android:textColor="#ffffff" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/savebtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rounded_button_bg"
        android:text="Save"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

</LinearLayout>

</LinearLayout>